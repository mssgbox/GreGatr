using System;
using System.Text.Json;
using HtmlAgilityPack;

public class MovieDataExtractor
{
    public static string? ExtractRawSchemaJson(string htmlContent)
    {
        var doc = new HtmlDocument();
        doc.LoadHtml(htmlContent);

        // This single XPath works universally on Metacritic, Rotten Tomatoes, and IMDb
        var scriptNode = doc.DocumentNode.SelectSingleNode("//script[@type='application/ld+json']");
        return scriptNode?.InnerText;
    }

    public static int? GetAggregateScore(string jsonRaw)
    {
        if (string.IsNullOrWhiteSpace(jsonRaw)) return null;

        using (JsonDocument jsonDoc = JsonDocument.Parse(jsonRaw))
        {
            JsonElement root = jsonDoc.RootElement;

            // Handle arrays (some sites embed multiple schemas in a single tag block)
            if (root.ValueKind == JsonValueKind.Array)
            {
                foreach (var element in root.EnumerateArray())
                {
                    if (TryExtractScore(element, out int score)) return score;
                }
            }
            else if (root.ValueKind == JsonValueKind.Object)
            {
                if (TryExtractScore(root, out int score)) return score;
            }
        }
        return null;
    }

    private static bool TryExtractScore(JsonElement element, out int score)
    {
        score = 0;
        if (element.TryGetProperty("aggregateRating", out JsonElement aggregateRating) &&
            aggregateRating.TryGetProperty("ratingValue", out JsonElement ratingValue))
        {
            // Metacritic stores numbers as integers/doubles directly; RT stores them as strings
            if (ratingValue.ValueKind == JsonValueKind.Number)
            {
                score = (int)ratingValue.GetDouble();
                return true;
            }
            if (ratingValue.ValueKind == JsonValueKind.String && int.TryParse(ratingValue.GetString(), out score))
            {
                return true;
            }
        }
        return false;
    }
}
